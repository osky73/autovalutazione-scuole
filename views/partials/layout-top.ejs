<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= titolo %> · Autoanalisi web per scuole</title>
<style>
  :root {
    --bg: #f6f5f2; --card: #ffffff; --ink: #1f2937; --muted: #6b7280;
    --brand: #2b4a63; --brand-light: #e8eef2; --good: #1f8a5f; --mid: #b9791f; --bad: #b23b3b;
    --border: #e5e2db;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg); color: var(--ink); line-height: 1.5;
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 32px 20px 80px; }
  .stepper { display: flex; gap: 6px; margin-bottom: 28px; }
  .stepper span { flex: 1; height: 4px; border-radius: 2px; background: var(--border); }
  .stepper span.done { background: var(--brand); }
  h1 { font-size: 1.5rem; margin: 0 0 6px; }
  h2 { font-size: 1.05rem; margin: 28px 0 10px; color: var(--brand); }
  p.lead { color: var(--muted); margin-top: 0; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 24px; margin-bottom: 18px; }
  label { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 6px; }
  input[type=text], input[type=url], select {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 8px;
    font-size: 1rem; margin-bottom: 18px; background: #fff;
  }
  button, .btn {
    background: var(--brand); color: #fff; border: none; padding: 12px 22px; border-radius: 8px;
    font-size: 1rem; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block;
  }
  button:hover, .btn:hover { background: #1f394c; }
  .btn.secondary { background: transparent; color: var(--brand); border: 1px solid var(--brand); }
  .actions { display: flex; align-items: center; gap: 10px; margin-top: 18px; }
  .actions .btn-principale { margin-left: auto; }
  .score-badge {
    display: flex; align-items: baseline; gap: 10px; background: var(--brand-light);
    border-radius: 12px; padding: 18px 20px; margin-bottom: 6px;
  }
  .score-badge .num { font-size: 2.6rem; font-weight: 700; color: var(--brand); }
  .score-badge .den { color: var(--muted); font-size: 1.1rem; }
  .worst {
    border-left: 4px solid var(--bad); background: #fbeeee; padding: 12px 14px; border-radius: 8px;
    margin: 14px 0 6px; font-size: 0.92rem;
  }
  .indicator-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.92rem;
  }
  .indicator-row:last-child { border-bottom: none; }
  .indicator-row .meta { color: var(--muted); font-size: 0.82rem; margin-top: 2px; }
  .pill { padding: 3px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; white-space: nowrap; }
  .pill.ottimizzato { background: #e3f4ea; color: var(--good); }
  .pill.presente { background: #e3f4ea; color: var(--good); }
  .pill.buono { background: #e3f4ea; color: var(--good); }
  .pill.parziale { background: #fbf1de; color: var(--mid); }
  .pill.sufficiente { background: #fbf1de; color: var(--mid); }
  .pill.assente { background: #fbeeee; color: var(--bad); }
  .pill.insufficiente { background: #fbeeee; color: var(--bad); }
  .pill.attivo { background: #e3f4ea; color: var(--good); }
  .pill.rallentato { background: #fbf1de; color: var(--mid); }
  .pill.fermo { background: #fbeeee; color: var(--bad); }
  .pos-item { padding: 14px 0; border-bottom: 1px solid var(--border); }
  .pos-item:last-child { border-bottom: none; }
  .pos-header { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 0.92rem; }
  .pos-header strong { text-transform: capitalize; }
  .pos-item .meta { color: var(--muted); font-size: 0.82rem; margin-top: 4px; }
  .query-list { list-style: disc; margin: 8px 0 0; padding-left: 20px; color: var(--muted); font-size: 0.82rem; }
  .query-list li { margin-bottom: 2px; }
  .theme-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 20px; }
  .theme-chip {
    border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px; cursor: pointer;
    font-size: 0.9rem; background: #fff; user-select: none;
  }
  .theme-chip input { margin-right: 6px; }
  .finding { border-left: 4px solid var(--mid); background: #fbf1de; padding: 12px 14px; border-radius: 8px; margin: 14px 0; }
  .muted { color: var(--muted); font-size: 0.88rem; }
  .spinner {
    width: 40px; height: 40px; margin: 0 auto;
    border: 4px solid var(--border); border-top-color: var(--brand);
    border-radius: 50%; animation: girare 0.8s linear infinite;
  }
  @keyframes girare { to { transform: rotate(360deg); } }
  footer.note { margin-top: 40px; font-size: 0.8rem; color: var(--muted); text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <div class="stepper">
    <span class="<%= step >= 1 ? 'done' : '' %>"></span>
    <span class="<%= step >= 2 ? 'done' : '' %>"></span>
    <span class="<%= step >= 3 ? 'done' : '' %>"></span>
    <span class="<%= step >= 4 ? 'done' : '' %>"></span>
    <span class="<%= step >= 5 ? 'done' : '' %>"></span>
    <span class="<%= step >= 6 ? 'done' : '' %>"></span>
    <span class="<%= step >= 7 ? 'done' : '' %>"></span>
    <span class="<%= step >= 8 ? 'done' : '' %>"></span>
    <span class="<%= step >= 9 ? 'done' : '' %>"></span>
    <span class="<%= step >= 10 ? 'done' : '' %>"></span>
  </div>
