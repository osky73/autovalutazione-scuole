<%- include('partials/layout-top', { titolo: 'Canali social indicati sul sito', step: 6 }) %>

<style>
  .fascia-select { font-size: 0.82rem; font-family: inherit; color: var(--ink); background: #fff; }
  .fascia-select option[value=""] { font-style: italic; color: var(--muted); }
</style>

<h1>Canali social indicati sul sito</h1>
<p class="lead">Abbiamo cercato i link ai canali social nelle pagine del sito. <% if (trovati.length) { %>Conferma quelli corretti ed escludi quelli sbagliati. I social non condividono pubblicamente frequenza e interazioni: se conosci indicativamente questi dati (li trovi negli Insights/Statistiche della piattaforma), scegli la fascia corrispondente. <% } %>Nel passaggio successivo troverai YouTube, la scheda Google Business Profile e la possibilità di aggiungere altri canali a mano.</p>

<form method="POST" action="/social/<%= sessione.id %>" id="form-social">
  <div class="card">
    <% if (trovati.length === 0) { %>
      <p class="muted">Non abbiamo trovato link a canali social, nel prossimo passaggio potrai segnalarli manualmente.</p>
    <% } else { %>
      <% trovati.forEach(function(c) { %>
        <div class="social-row" data-url="<%= c.url %>" data-platform="<%= c.platform %>" style="padding:10px 0; border-bottom:1px solid var(--border);">
          <div style="display:flex; align-items:center; flex-wrap:wrap; gap:10px;">
            <label style="display:flex; align-items:center; gap:8px; margin:0; font-weight:600; flex:1; min-width:160px;">
              <input type="checkbox" name="includiTrovato" value="<%= c.url %>" checked style="margin:0; width:auto;" />
              <span><%= c.label %></span>
            </label>
            <a href="<%= c.url %>" target="_blank" rel="noopener" class="muted" style="font-size:0.82rem; word-break:break-all;"><%= c.url %></a>
            <label style="display:flex; align-items:center; gap:6px; margin:0; font-size:0.82rem; font-weight:400; white-space:nowrap;">
              <input type="checkbox" name="meno6mesiTrovato" value="<%= c.url %>" class="meno6mesi-check" style="margin:0; width:auto;" />
              Aperto di recente (meno di 6 mesi)
            </label>
          </div>
          <div class="fascia-row" style="display:flex; flex-wrap:wrap; gap:14px; margin-top:8px; font-size:0.82rem;">
            <label style="display:flex; align-items:center; gap:6px; margin:0; font-weight:400;">
              Post/settimana
              <select name="freqTrovato" class="fascia-select" style="margin:0; padding:6px 8px; width:auto;">
                <option value="" style="font-style:italic;">(indica un range)</option>
                <option value="alta">&ge; 3 a settimana</option>
                <option value="media">2 a settimana</option>
                <option value="bassa">&le; 1 a settimana</option>
              </select>
            </label>
            <label style="display:flex; align-items:center; gap:6px; margin:0; font-weight:400;">
              Interazioni (media per contenuto)
              <select name="likeTrovato" class="fascia-select" style="margin:0; padding:6px 8px; width:auto;">
                <option value="" style="font-style:italic;">(indica un range)</option>
                <option value="alta">&ge; 30</option>
                <option value="media">15 &ndash; 30</option>
                <option value="bassa">&le; 15</option>
              </select>
            </label>
            <label style="display:flex; align-items:center; gap:6px; margin:0; font-weight:400;">
              Follower
              <select name="followerTrovato" class="fascia-select fascia-follower" style="margin:0; padding:6px 8px; width:auto;">
                <option value="" style="font-style:italic;">(indica un range)</option>
                <option value="alta">&gt; 1000</option>
                <option value="media">500 &ndash; 1000</option>
                <option value="bassa">&lt; 500</option>
              </select>
            </label>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <%- include('partials/prossimo-passo', { testo: "altri canali social e scheda Google Business Profile", salta: true }) %>
  <div class="actions">
    <a class="btn secondary" href="<%= sessione.posizionamentoSaltato ? '/verifica/' : '/posizionamento/' %><%= sessione.id %>">← Indietro</a>
    <button type="submit" class="btn btn-principale">Continua →</button>
  </div>
</form>

<script>
  function collegaMeno6Mesi(checkbox, campi) {
    function aggiorna() {
      campi.forEach(function (el) {
        el.disabled = checkbox.checked;
        if (checkbox.checked) el.value = '';
      });
    }
    checkbox.addEventListener('change', aggiorna);
    aggiorna();
  }

  function collegaRiga(riga) {
    var checkbox = riga.querySelector('.meno6mesi-check');
    var campi = Array.prototype.slice.call(riga.querySelectorAll('.fascia-select'));
    if (checkbox && campi.length) collegaMeno6Mesi(checkbox, campi);
  }

  document.querySelectorAll('.social-row').forEach(collegaRiga);
</script>

<%- include('partials/layout-bottom', { step: 6, sessione: sessione }) %>
