<%- include('partials/layout-top', { titolo: 'Posizionamento Google', step: 5 }) %>

<h1>Posizionamento su Google</h1>
<p class="lead">Per ogni competenza verifichiamo un intero cluster di ricerche — la long-tail generica "scuola media [competenza] <%= sessione.localita %>" più le parole chiave specifiche del tema trovate nel sito — e mostriamo il posizionamento migliore ottenuto per <%= sessione.audit.homeUrl %>, indicando con quale ricerca.</p>

<div class="card">
  <% risultati.forEach(function(r) {
       var analizzati = r.risultatiQuery.filter(function(x){ return x.disponibile; }).map(function(x){ return x.risultatiAnalizzati || 0; });
       var maxAnalizzati = analizzati.length ? Math.max.apply(null, analizzati) : 0;
  %>
    <div class="indicator-row">
      <div>
        <div><strong><%= r.label %></strong></div>
        <div class="meta">Ricerche: <%= r.risultatiQuery.map(function(x){ return '"' + x.query + '"'; }).join(', ') %></div>
        <% if (r.migliore) { %>
          <div class="meta">Trovato con: "<%= r.migliore.query %>"</div>
        <% } else if (!r.disponibile) { %>
          <div class="meta">Google non raggiungibile per nessuna ricerca del cluster</div>
        <% } %>
      </div>
      <% if (!r.disponibile) { %>
        <span class="pill assente">Non disponibile</span>
      <% } else if (r.migliore) { %>
        <span class="pill ottimizzato">Posizione <%= r.migliore.posizione %></span>
      <% } else if (maxAnalizzati > 0) { %>
        <span class="pill parziale">Non presente tra i primi <%= maxAnalizzati %> risultati</span>
      <% } else { %>
        <span class="pill parziale">Non presente nei risultati analizzati</span>
      <% } %>
    </div>
  <% }) %>

  <p class="muted" style="margin-top:16px;">Nota: il controllo interroga direttamente Google, senza una API ufficiale. Google può bloccare o alterare i risultati in qualsiasi momento (compare come "Non disponibile"): trattalo come un'indicazione, non come un dato certo.</p>
</div>

<div class="actions">
  <a class="btn secondary" href="/verifica/<%= sessione.id %>">← Indietro</a>
  <a class="btn btn-principale" href="/social/<%= sessione.id %>">Continua →</a>
</div>

<%- include('partials/layout-bottom', { step: 5, sessione: sessione }) %>
