<%- include('partials/layout-top', { titolo: 'Verifica competenze', step: 5 }) %>

<h1>Coerenza tra le competenze dichiarate e i contenuti del sito</h1>
<p class="lead">Confrontiamo le competenze che la scuola dichiara con ciò che il sito comunica davvero.</p>

<div class="card">
  <h2>Competenze dichiarate dalla scuola</h2>
  <% if (!sessione.dichiarati.length) { %>
    <p class="muted">Non è stata indicata nessuna competenza.</p>
  <% } %>
  <div class="theme-list">
    <% sessione.dichiarati.forEach(function(t) {
         var trovato = t.key
           ? temi.temiTrovati.find(function(x){ return x.key === t.key; })
           : (liberiTrovati || {})[t.label];
    %>
      <span class="theme-chip" style="cursor:default;">
        <%= t.label %>
        <% if (trovato) { %><span class="muted">(trovato, <%= trovato.count %><% if (trovato.url) { %> — <a href="<%= trovato.url %>" target="_blank" rel="noopener">vedi pagina</a><% } %>)</span><% } else { %><span class="text-bad">(non trovato sul sito)</span><% } %>
      </span>
    <% }) %>
  </div>

  <% var chiaviDichiarate = new Set(sessione.dichiarati.filter(function(t){ return t.key; }).map(function(t){ return t.key; }));
     var aggiuntive = temi.temiTrovati.filter(function(t){ return !chiaviDichiarate.has(t.key); });
  %>
  <h2>Competenze individuate nel sito</h2>
  <% if (aggiuntive.length === 0) { %>
    <p class="muted">Abbiamo controllato i contenuti del sito e non abbiamo trovato una quantità omogenea di contenuti che identificasse una competenza tra quelle standard.</p>
  <% } else { %>
    <div class="theme-list">
      <% aggiuntive.forEach(function(t) { %>
        <span class="theme-chip" style="cursor:default;"><%= t.label %> <span class="muted">(<%= t.count %><% if (t.url) { %> — <a href="<%= t.url %>" target="_blank" rel="noopener">vedi pagina</a><% } %>)</span></span>
      <% }) %>
    </div>
  <% } %>

  <% if (finding) { %>
    <div class="finding">
      <strong>Osservazione:</strong> <%= finding %>
    </div>
  <% } %>
</div>

<%- include('partials/prossimo-passo', { testo: "posizionamento su Google", salta: true, href: "/posizionamento/" + sessione.id + "/salta" }) %>

<div class="actions">
  <a class="btn secondary" href="/audit/<%= sessione.id %>">← Indietro</a>
  <a class="btn btn-principale" href="/posizionamento/<%= sessione.id %>">Continua →</a>
</div>

<%- include('partials/layout-bottom', { step: 5, sessione: sessione }) %>
