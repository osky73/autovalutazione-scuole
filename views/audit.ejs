<%- include('partials/layout-top', { titolo: 'Audit tecnico', step: 2 }) %>

<h1><%= sessione.scuola %></h1>
<p class="lead">Audit tecnico di <a href="<%= audit.homeUrl %>" target="_blank" rel="noopener"><%= audit.homeUrl %></a> — velocità mobile, struttura SEO di base, scheda Google, ultimo contenuto pubblicato.</p>

<div class="card">
  <div class="score-badge">
    <span class="num"><%= audit.score %></span>
    <span class="den">/ 100 · Sito</span>
  </div>
  <p class="muted">Basato su <%= audit.pagineTestate %> pagine testate su <%= audit.pagineTotali %> (mediana tra le pagine, per evitare falsi positivi).</p>

  <div class="worst">
    <strong>Il dato peggiore:</strong> <%= audit.worst.label %> — <%= audit.worst.dettaglio %>
  </div>

  <h2>Dettaglio indicatori</h2>
  <% audit.indicators.forEach(function(ind) { %>
    <div class="indicator-row">
      <div>
        <div><%= ind.label %></div>
        <div class="meta"><%= ind.dettaglio %></div>
      </div>
      <span class="pill <%= ind.livello.toLowerCase() %>"><%= ind.livello %></span>
    </div>
  <% }) %>

  <% if (audit.mobileSpeed && audit.mobileSpeed.source === 'euristica') { %>
    <p class="muted" style="margin-top:14px;">Nota: la velocità mobile è stata stimata in modo euristico (peso pagina e tempo di risposta) perché l'API PageSpeed Insights non era raggiungibile in questo momento.</p>
  <% } %>
</div>

<% if (audit.contenuti) { %>
<div class="card">
  <h2 style="margin-top:0;">Nurturing — Aggiornamento contenuti / Blog</h2>
  <div class="indicator-row">
    <div>
      <div>Sezione news/blog</div>
      <div class="meta"><%= audit.contenuti.messaggio %></div>
    </div>
    <span class="pill <%= audit.contenuti.stato %>"><%= audit.contenuti.stato.charAt(0).toUpperCase() + audit.contenuti.stato.slice(1) %></span>
  </div>
  <% if (audit.contenuti.sezioneTrovata) { %>
    <p class="muted" style="margin-top:14px;">
      Articoli negli ultimi 6 mesi: <%= audit.contenuti.articoli6Mesi %> ·
      negli ultimi 12 mesi: <%= audit.contenuti.articoli12Mesi %>
      <% if (audit.contenuti.intervalloMedioGiorni != null) { %> · intervallo medio: <%= audit.contenuti.intervalloMedioGiorni %> giorni<% } %>
      <% if (audit.contenuti.gapMassimoGiorni != null) { %> · gap più lungo: <%= audit.contenuti.gapMassimoGiorni %> giorni<% } %>
    </p>
  <% } %>
  <% if (audit.contenuti.divergenzaCadenza && audit.contenuti.divergenzaCadenza.divergente) { %>
    <div class="finding">
      La cadenza di pubblicazione dichiarata ("<%= audit.contenuti.divergenzaCadenza.dichiarata %>") è significativamente più frequente di quella verificata (un articolo ogni <%= audit.contenuti.divergenzaCadenza.intervalloVerificatoGiorni %> giorni in media).
    </div>
  <% } %>
</div>
<% } %>

<div class="actions">
  <a class="btn secondary" href="/">← Indietro</a>
  <a class="btn btn-principale" href="/dichiarazione/<%= sessione.id %>">Continua →</a>
</div>

<%- include('partials/layout-bottom', { step: 2, sessione: sessione }) %>
