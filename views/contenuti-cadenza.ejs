<%- include('partials/layout-top', { titolo: 'Piano editoriale', step: 10 }) %>

<h1>Avete un piano editoriale per il sito?</h1>
<p class="lead">Con quale cadenza pensate di pubblicare contenuti su blog/news? La confrontiamo con quanto risulta davvero dal sito nella pagina seguente.</p>

<form method="POST" action="/contenuti/<%= sessione.id %>/cadenza">
  <div class="card">
    <label for="cadenzaEditoriale">Cadenza di pubblicazione prevista</label>
    <select id="cadenzaEditoriale" name="cadenzaEditoriale">
      <option value="">Non abbiamo un piano editoriale</option>
      <option value="settimanale">Settimanale</option>
      <option value="quindicinale">Quindicinale</option>
      <option value="mensile">Mensile</option>
      <option value="trimestrale">Trimestrale</option>
    </select>
  </div>

  <div class="actions">
    <a class="btn secondary" href="/social/<%= sessione.id %>/analisi">← Indietro</a>
    <button type="submit" class="btn btn-principale">Continua →</button>
  </div>
</form>

<%- include('partials/layout-bottom', { step: 10, sessione: sessione }) %>
